%YAML 1.2
---
name: Session List
scope: text.session-list
hidden: true

contexts:
  main:
    - match: '^SESSIONS\b'
      scope: markup.heading.session-list
      push: header_rest

    - match: '^(STARRED|CURRENT|HISTORY)\s+\((\d+)\)'
      captures:
        0: entity.name.section.session-list
        2: constant.numeric.session-list

    - match: '^\s+\(none\)$'
      scope: comment.line.session-list

    - match: '^●'
      scope: keyword.working.session-list
      push: row_rest

    - match: '^\?'
      scope: keyword.input.session-list
      push: row_rest

    - match: '^\*'
      scope: keyword.unread.session-list
      push: row_rest

    - match: '^○'
      scope: keyword.ready.session-list
      push: row_rest

    - match: '^⏸'
      scope: keyword.sleeping.session-list
      push: row_rest

    - match: '^·'
      scope: comment.mark.session-list
      push: row_rest

  header_rest:
    - match: '\b(enter|dclick|r|v|s|f)\b'
      scope: keyword.operator.session-list
    - match: '\b(open|rename|reveal|star|fork)\b'
      scope: comment.line.session-list
    - match: '·'
      scope: comment.line.session-list
    - match: '$'
      pop: true

  row_rest:
    - match: '★'
      scope: keyword.star.session-list
    # First token is the backend column only — do not scan the title.
    - match: '(?:claude|grok|kimi|codex|copilot|pi|dsr|deepseek|[A-Z]{2,3})\b'
      scope: storage.type.backend.session-list
      set: row_title
    - match: '$'
      pop: true

  row_title:
    - match: '\s+\d+q\b'
      scope: comment.nq.session-list
    - match: '\s+(busy)\s*$'
      scope: keyword.working.session-list
      pop: true
    - match: '\s+(wait)\s*$'
      scope: keyword.input.session-list
      pop: true
    - match: '\s+(new)\s*$'
      scope: keyword.unread.session-list
      pop: true
    - match: '\s+(idle)\s*$'
      scope: keyword.ready.session-list
      pop: true
    - match: '\s+(now|\d+[smhdw])\s*$'
      scope: comment.line.time.session-list
      pop: true
    - match: '$'
      pop: true
